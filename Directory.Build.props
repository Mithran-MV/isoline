<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>

    <Product>Isoline</Product>
    <Company>Mithran MV</Company>
    <Authors>Mithran MV</Authors>
    <Copyright>Copyright (c) 2026 Mithran MV; portions copyright (c) 2018 Martin Pittermann</Copyright>
    <Version>2.0.0</Version>
    <RepositoryUrl>https://github.com/Mithran-MV/isoline</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
  </PropertyGroup>

</Project>
