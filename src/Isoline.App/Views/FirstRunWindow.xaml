<Window x:Class="Isoline.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Isoline" Height="470" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">

    <!--
        First run. Upstream hid the serial port picker inside the settings dialog, and its
        own README admitted that was the single most common support question. Asking the
        three questions that actually matter, once, on the first launch, removes it.
    -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Connect to your machine" FontSize="{DynamicResource FontSizeXl}" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Three settings and you are cutting. All of them can be changed later under Settings."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">

            <TextBlock Text="CONTROLLER FIRMWARE" Style="{StaticResource SectionCaption}"/>
            <ComboBox Name="ComboFirmware" Margin="0,0,0,4"/>
            <TextBlock Name="LabelFirmwareHint" Style="{StaticResource BannerBody}" Margin="0,0,0,16"/>

            <TextBlock Text="HOW IS IT CONNECTED?" Style="{StaticResource SectionCaption}"/>
            <ComboBox Name="ComboConnection" Margin="0,0,0,16" SelectionChanged="ComboConnection_SelectionChanged"/>

            <StackPanel Name="PanelSerial">
                <TextBlock Text="SERIAL PORT" Style="{StaticResource SectionCaption}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="ComboPort" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="Refresh" Click="ButtonRefresh_Click" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="BAUD RATE" Style="{StaticResource SectionCaption}"/>
                <ComboBox Name="ComboBaud" Margin="0,0,0,4"/>
                <TextBlock Text="115200 is the Grbl default. Only change this if you flashed a different rate."
                           Style="{StaticResource BannerBody}"/>
            </StackPanel>

            <StackPanel Name="PanelNetwork" Visibility="Collapsed">
                <TextBlock Text="ADDRESS" Style="{StaticResource SectionCaption}"/>
                <TextBox Name="TextBoxHost" Margin="0,0,0,12"/>

                <TextBlock Text="PORT" Style="{StaticResource SectionCaption}"/>
                <TextBox Name="TextBoxPort" Margin="0,0,0,4"/>
                <TextBlock Text="FluidNC listens for telnet on port 23 and for WebSocket on 81."
                           Style="{StaticResource BannerBody}"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Skip" Click="ButtonSkip_Click" MinWidth="90"/>
            <Button Content="Save and connect" Click="ButtonSave_Click" Style="{StaticResource PrimaryButton}"
                    MinWidth="150" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
