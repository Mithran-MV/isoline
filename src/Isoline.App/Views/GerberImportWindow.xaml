<Window x:Class="Isoline.GerberImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Gerber" Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Gerber to isolation toolpath" FontSize="{DynamicResource FontSizeXl}" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Reads a copper layer and generates the passes that cut the traces free of the surrounding copper."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- file -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="TextBoxFile" Grid.Column="0" IsReadOnly="True" Text="No file selected"/>
            <Button Grid.Column="1" Content="Choose file..." Click="ButtonBrowse_Click" Margin="8,0,0,0" MinWidth="120"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- cutting parameters -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="TOOL" Style="{StaticResource SectionCaption}"/>

                    <CheckBox Name="CheckVBit" Content="V-shaped cutter" IsChecked="True"
                              Checked="Parameter_Changed" Unchecked="Parameter_Changed"
                              Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                    <StackPanel Name="PanelVBit">
                        <TextBlock Text="Included angle (degrees)" Style="{StaticResource BannerBody}"/>
                        <TextBox Name="TextVAngle" Text="30" TextChanged="Parameter_Changed" Margin="0,0,0,8"/>

                        <TextBlock Text="Tip flat width (mm)" Style="{StaticResource BannerBody}"/>
                        <TextBox Name="TextVTip" Text="0.1" TextChanged="Parameter_Changed" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Name="PanelStraight" Visibility="Collapsed">
                        <TextBlock Text="Cutter diameter (mm)" Style="{StaticResource BannerBody}"/>
                        <TextBox Name="TextDiameter" Text="0.4" TextChanged="Parameter_Changed" Margin="0,0,0,8"/>
                    </StackPanel>

                    <TextBlock Text="Cut depth (mm, negative)" Style="{StaticResource BannerBody}"/>
                    <TextBox Name="TextDepth" Text="-0.1" TextChanged="Parameter_Changed" Margin="0,0,0,16"/>

                    <TextBlock Text="PASSES" Style="{StaticResource SectionCaption}"/>

                    <TextBlock Text="Number of passes" Style="{StaticResource BannerBody}"/>
                    <TextBox Name="TextPasses" Text="1" TextChanged="Parameter_Changed" Margin="0,0,0,8"/>

                    <TextBlock Text="Stepover (fraction of tool width)" Style="{StaticResource BannerBody}"/>
                    <TextBox Name="TextStepover" Text="0.8" TextChanged="Parameter_Changed" Margin="0,0,0,16"/>

                    <TextBlock Text="MOTION" Style="{StaticResource SectionCaption}"/>

                    <TextBlock Text="Feed rate (mm/min)" Style="{StaticResource BannerBody}"/>
                    <TextBox Name="TextFeed" Text="300" Margin="0,0,0,8"/>

                    <TextBlock Text="Plunge rate (mm/min)" Style="{StaticResource BannerBody}"/>
                    <TextBox Name="TextPlunge" Text="100" Margin="0,0,0,8"/>

                    <TextBlock Text="Safe height (mm)" Style="{StaticResource BannerBody}"/>
                    <TextBox Name="TextSafe" Text="2" Margin="0,0,0,8"/>

                    <TextBlock Text="Spindle speed (0 to leave it alone)" Style="{StaticResource BannerBody}"/>
                    <TextBox Name="TextSpindle" Text="10000" Margin="0,0,0,8"/>

                    <CheckBox Name="CheckOptimise" Content="Shorten travel between contours" IsChecked="True"
                              Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- what the settings will actually produce -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusM}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="RESULT" Style="{StaticResource SectionCaption}"/>

                        <TextBlock Name="LabelSummary" Style="{StaticResource BannerBody}"
                                   Text="Choose a Gerber file to see what will be cut."
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="EFFECTIVE CUT WIDTH" Style="{StaticResource SectionCaption}"/>
                        <TextBlock Name="LabelCutWidth" Style="{StaticResource BannerBody}" Text="-" Margin="0,0,0,12"/>

                        <TextBlock Text="WARNINGS" Style="{StaticResource SectionCaption}"/>
                        <ItemsControl Name="ListWarnings" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource BannerBody}"
                                               Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Name="LabelNoWarnings" Style="{StaticResource BannerBody}" Text="None."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="ButtonCancel_Click" MinWidth="90"/>
            <Button Name="ButtonGenerate" Content="Generate toolpath" Click="ButtonGenerate_Click"
                    Style="{StaticResource PrimaryButton}" MinWidth="170" Margin="8,0,0,0" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
