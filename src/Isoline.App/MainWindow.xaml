<Window x:Class="Isoline.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:h="http://helix-toolkit.org/wpf"
		xmlns:local="clr-namespace:Isoline"
		xmlns:util="clr-namespace:Isoline.Util"
		mc:Ignorable="d"
		AllowDrop="True"
		Drop="Window_Drop"
		DragEnter="Window_DragEnter"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
		PreviewKeyDown="Window_PreviewKeyDown"
		Icon="Resources/Isoline.png"
		Title="{Binding WindowTitle,Mode=OneWay}" Height="{util:SettingBinding WindowHeight}" Width="{util:SettingBinding WindowWidth}" Closing="Window_Closing">
    <Window.TaskbarItemInfo>
        <!-- mirrors the job progress onto the taskbar button -->
        <TaskbarItemInfo x:Name="TaskbarInfo" ProgressState="None" ProgressValue="0"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <ResourceDictionary Source="MainWindow.Resources.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- TOP NAVBAR -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Left: Connection & States -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Machine connection -->
                    <Button Name="ButtonConnect" Content="Connect" Style="{StaticResource styleButton}" Click="ButtonConnect_Click" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Name="ButtonDisconnect" Visibility="Collapsed" Content="Disconnect" Style="{StaticResource styleButton}" Click="ButtonDisconnect_Click" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Name="ButtonSettings" Content="Settings" Style="{StaticResource styleButton}" Click="ButtonSettings_Click" Margin="0,0,10,0"/>
                    <Button Content="GRBL Settings" Style="{StaticResource styleButton}" Click="ShowGrblSettings_Click" Name="ButtonGrblSettings" Margin="0,0,20,0"/>
                    
                    <!--
                        Machine state pill. Colour and label come from StatusPresentation so
                        that "Alarm" is unmistakable at a glance and "Idle" is legible -
                        it used to be painted black on a dark background.
                    -->
                    <Border Name="StatePillBorder" Style="{StaticResource StatePill}" Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceOverlayBrush}" BorderBrush="{DynamicResource LineBrush}"
                            MouseLeftButtonUp="ButtonStatus_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Name="StatePillDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextSubtleBrush}"/>
                            <TextBlock Name="ButtonStatus" Text="OFFLINE" Style="{StaticResource StatePillText}"
                                       Foreground="{DynamicResource TextSubtleBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Center: Global Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="ButtonCycleStart" Click="ButtonCycleStart_Click" Content="START" Style="{StaticResource styleButton}" Background="{DynamicResource SuccessBrush}" Foreground="White" FontWeight="Bold" FontSize="16" Width="100" Height="40" Margin="5,0"/>
                    <Button Name="ButtonFeedHold" Click="ButtonFeedHold_Click" Content="HOLD" Style="{StaticResource styleButton}" Background="{DynamicResource WarningBrush}" Foreground="White" FontWeight="Bold" FontSize="16" Width="100" Height="40" Margin="5,0"/>
                    <Button Name="ButtonSoftReset" Click="ButtonSoftReset_Click" Content="RESET" Style="{StaticResource styleButton}" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" FontSize="16" Width="100" Height="40" Margin="5,0"/>
                </StackPanel>

                <!-- Right: Homing & Units -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,20,0">
                        <Button Name="ButtonMachineHome" Content="Home Machine" Style="{StaticResource styleButton}" Click="ButtonMachineHome_Click" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Inv Y Homing" ToolTip="Inverts Y axis homing direction ($23=2)" Click="ButtonInvertYHoming_Click" Style="{StaticResource styleButton}" FontSize="10" Margin="0,0,2,0" Padding="5,2"/>
                            <Button Content="Rst Y Homing" ToolTip="Resets Y axis homing direction ($23=0)" Click="ButtonResetYHoming_Click" Style="{StaticResource styleButton}" FontSize="10" Padding="5,2"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Name="ButtonUnit" Content="Metric" Click="ButtonUnit_Click" Style="{StaticResource styleButton}" Margin="0,0,5,0" ToolTip="Unit System - Click to Toggle"/>
                    <Button Name="ButtonDistanceMode" Content="Absolute" Click="ButtonDistanceMode_Click" Margin="0,0,5,0" Style="{StaticResource styleButton}" ToolTip="Distance Mode - Click to Toggle"/>
                    <Button Name="ButtonArcPlane" Content="XY-Plane" Click="ButtonArcPlane_Click" Margin="0,0,0,0" Style="{StaticResource styleButton}" ToolTip="Arc Plane - Click to Reset to XY"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Alarm / error banner. Docked above everything and stays put until dismissed:
            an alarm that scrolls out of the console unread is how an operator ends up
            wondering why the machine stopped.
        -->
        <Border Name="AlertBanner" DockPanel.Dock="Top" Style="{StaticResource Banner}" Visibility="Collapsed"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource DangerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Name="AlertAccent" Grid.Column="0" Background="{DynamicResource DangerBrush}"
                        CornerRadius="2" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="AlertTitle" Style="{StaticResource BannerTitle}"
                               Foreground="{DynamicResource DangerTextBrush}" Text="Alarm"/>
                    <TextBlock Name="AlertBody" Style="{StaticResource BannerBody}" Text=""/>
                </StackPanel>

                <Button Name="ButtonAlertAction" Grid.Column="2" Content="Unlock" Click="ButtonAlertAction_Click"
                        Style="{StaticResource WarningButton}" Margin="12,0,6,0" Visibility="Collapsed"/>
                <Button Grid.Column="3" Content="Dismiss" Click="ButtonAlertDismiss_Click"
                        Style="{StaticResource styleButton}"/>
            </Grid>
        </Border>

        <!-- Job progress: percentage, elapsed and estimated time remaining -->
        <Border Name="JobProgressBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="LabelJobPercent" Grid.Column="0" Text="0%" MinWidth="52"
                           FontFamily="{DynamicResource NumericFont}" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>

                <ProgressBar Name="BarJobProgress" Grid.Column="1" Style="{StaticResource JobProgress}"
                             Minimum="0" Maximum="1" Value="0" Margin="8,0"/>

                <TextBlock Name="LabelJobTime" Grid.Column="2" Text="00:00 elapsed"
                           FontFamily="{DynamicResource NumericFont}" FontSize="{DynamicResource FontSizeS}"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- LEFT SIDEBAR -->
        <Border DockPanel.Dock="Left" Width="280" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <!-- FILE PANEL -->
                    <GroupBox Header="File Operation" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Name="ButtonFileOpen" Click="ButtonOpen_Click" Content="Open" Style="{StaticResource styleButton}" Grid.Column="0" Margin="0,0,5,0"/>
                                <Button Name="ButtonFileSave" Click="ButtonSave_Click" Content="Save" Style="{StaticResource styleButton}" Grid.Column="1" Margin="2,0,2,0"/>
                                <Button Name="ButtonFileClear" Click="ButtonClear_Click" Content="Clear" Style="{StaticResource styleButton}" Grid.Column="2" Margin="5,0,0,0"/>
                            </Grid>

                            <!-- Gerber straight to toolpath, no external CAM step -->
                            <Button Name="ButtonImportGerber" Click="ButtonImportGerber_Click"
                                    Content="Import Gerber..." Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,10" ToolTip="Read a copper layer and generate the isolation toolpath"/>
                            
                            <!-- File progress -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="Lines: "/>
								<TextBlock Foreground="White" Name="RunFilePosition" Text="0"/>
								<TextBlock Foreground="{DynamicResource TextMutedBrush}" Text=" / "/>
								<TextBlock Foreground="White" Name="RunFileLength" Text="0"/>
                            </StackPanel>
                            
                            <Border Background="{DynamicResource SurfaceOverlayBrush}" CornerRadius="4" Height="150" Margin="0,0,0,10">
                                <ListView Name="ListViewFile" ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0"/>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Name="ButtonFileStart" Click="ButtonFileStart_Click" Content="Play" Style="{StaticResource styleButton}" Background="{DynamicResource SuccessBrush}" Foreground="White" Grid.Column="0" Margin="0,0,5,0"/>
                                <Button Name="ButtonFilePause" Click="ButtonFilePause_Click" Content="Pause" Style="{StaticResource styleButton}" Background="{DynamicResource WarningBrush}" Foreground="White" Grid.Column="1" Margin="2,0,2,0"/>
                                <Button Name="ButtonFileGoto" Click="ButtonFileGoto_Click" Content="Go To" Style="{StaticResource styleButton}" Grid.Column="2" Margin="5,0,0,0"/>
                            </Grid>

                            <CheckBox Name="CheckBoxPauseOnM0" Content="Pause on M0/M1/M30" IsChecked="{util:SettingBinding PauseFileOnHold}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
								<TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="Time: "/>
								<TextBlock Foreground="{DynamicResource AccentTextBrush}" Name="RunFileRunTime" Text="00:00:00" FontWeight="Bold"/>
								<TextBlock Foreground="{DynamicResource TextMutedBrush}" Text=" / "/>
								<TextBlock Foreground="{DynamicResource AccentTextBrush}" Name="RunFileDuration" Text="00:00:00" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- EDIT PANEL -->
                    <GroupBox Header="Edit Toolpath" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <WrapPanel Margin="5">
                            <Button Name="ButtonEditSimplify" Click="ButtonEditSimplify_Click" Content="Simplify" Style="{StaticResource styleButton}" Margin="2" Width="110"/>
                            <Button Name="ButtonEditApplyHeightMap" Click="ButtonEditApplyHeightMap_Click" Content="Apply HeightMap" Style="{StaticResource styleButton}" Margin="2" Width="110"/>
                            <Button Name="ButtonEditArcToLines" Click="ButtonEditArcToLines_Click" Content="ArcsToLines" Style="{StaticResource styleButton}" Margin="2" Width="110"/>
                            <Button Name="ButtonEditSplit" Click="ButtonEditSplit_Click" Content="Split" Style="{StaticResource styleButton}" Margin="2" Width="110"/>
                            <Button Name="ButtonEditRotateCW" Click="ButtonEditRotateCW_Click" Content="Rotate CW" Style="{StaticResource styleButton}" Margin="2" Width="110"/>
                        </WrapPanel>
                    </GroupBox>

                    <!-- MACROS -->
                    <GroupBox Header="Macros" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <StackPanel Name="stackPanelMacros" Margin="5">
                            <Button Content="+ Add Macro" Name="ButtonAddMacro" Click="ButtonAddMacro_Click" Style="{StaticResource styleButton}" Margin="0,0,0,10" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White"/>
                            <StackPanel Name="StackPanelMacros">
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- MACHINE CALIBRATION -->
                    <GroupBox Header="Machine Calibration" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <CheckBox x:Name="CheckBoxHomeEnable" Content="Enable Homing ($22)" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Width="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Homing Dir Invert Mask ($23)" Width="180" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox x:Name="TextBoxHomeMask" Width="60" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="White" BorderThickness="0" Padding="2" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Homing Feed ($24)" Width="180" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox x:Name="TextBoxHomeFeed" Width="60" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="White" BorderThickness="0" Padding="2" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Label Content="Homing Seek ($25)" Width="180" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox x:Name="TextBoxHomeSeek" Width="60" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="White" BorderThickness="0" Padding="2" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Axis Setup (Steps/mm)" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="X Axis ($100)" Width="180" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox x:Name="TextBoxXSteps" Width="60" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="White" BorderThickness="0" Padding="2" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Y Axis ($101)" Width="180" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox x:Name="TextBoxYSteps" Width="60" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="White" BorderThickness="0" Padding="2" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Label Content="Z Axis ($102)" Width="180" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox x:Name="TextBoxZSteps" Width="60" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="White" BorderThickness="0" Padding="2" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Read from GRBL" Click="ButtonReadCalibration_Click" Style="{StaticResource styleButton}" Height="25" Background="{DynamicResource AccentBrush}" Foreground="White" Margin="0,0,0,5"/>
                            <Button Content="Save to GRBL" Click="ButtonSaveCalibration_Click" Style="{StaticResource styleButton}" Height="25" Background="{DynamicResource SuccessBrush}" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <!-- DEBUG -->
                    <GroupBox Header="Debug &amp; Viewport" Foreground="White" FontWeight="SemiBold">
                        <StackPanel Margin="5">
                            <CheckBox Content="Show Status Messages" IsChecked="{util:SettingBinding ShowStatusLines}" Margin="0,0,0,5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Console Fade (s):" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Text="{util:SettingBinding ConsoleFadeTime}" Width="50" Margin="5,0,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource styleButton}" Content="Save Viewport Orientation" Margin="0,2" Click="ButtonSaveViewport_Click"/>
                            <Button Style="{StaticResource styleButton}" Content="Restore Viewport" Margin="0,2" Click="ButtonRestoreViewport_Click"/>
                            <Button Style="{StaticResource styleButton}" Content="Reset 3D Viewport" Margin="0,2" Click="ButtonResetViewport_Click"/>
                            <Button Style="{StaticResource styleButton}" Content="Lay flat 3D Viewport" Margin="0,2" Click="ButtonLayFlatViewport_Click"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT SIDEBAR -->
        <Border DockPanel.Dock="Right" Width="300" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    
                    <!-- HUGE DRO (DIGITAL READOUT) -->
                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DIGITAL READOUT" Foreground="{DynamicResource TextSubtleBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            
                            <!-- X Axis -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X" Grid.Column="0" Foreground="{DynamicResource DangerTextBrush}" FontWeight="Black" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox Name="LabelPosX" Grid.Column="1" Text="0.000" IsReadOnly="True" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox Name="LabelPosMX" Grid.Column="2" Text="0.000" IsReadOnly="True" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            </Grid>
                            
                            <!-- Y Axis -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Y" Grid.Column="0" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Black" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox Name="LabelPosY" Grid.Column="1" Text="0.000" IsReadOnly="True" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox Name="LabelPosMY" Grid.Column="2" Text="0.000" IsReadOnly="True" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            </Grid>
                            
                            <!-- Z Axis -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Z" Grid.Column="0" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Black" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox Name="LabelPosZ" Grid.Column="1" Text="0.000" IsReadOnly="True" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBox Name="LabelPosMZ" Grid.Column="2" Text="0.000" IsReadOnly="True" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            </Grid>

                            <Separator Background="{DynamicResource SurfaceOverlayBrush}" Margin="0,15"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Realtime Feed: " Foreground="{DynamicResource TextMutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Name="LabelFeedRateRealtime" Text="0" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text=" mm/min" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- JOGGING (MANUAL) -->
                    <GroupBox Header="Jog Controls" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <CheckBox Name="CheckBoxEnableJog" Content="Enable Keyboard Jogging" Checked="CheckBoxEnableJog_Checked" Unchecked="CheckBoxEnableJog_Unchecked" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                            
                            <Border Background="{DynamicResource SurfaceOverlayBrush}" CornerRadius="4" Padding="1" IsEnabled="{Binding ElementName=CheckBoxEnableJog, Path=IsChecked}">
                                <TextBox Name="TextBoxJog" HorizontalContentAlignment="Center" Height="40" Text="CLICK HERE TO JOG WITH KEYBOARD" Foreground="{DynamicResource WarningTextBrush}" Background="Transparent" BorderThickness="0" FontWeight="Bold"
										 PreviewKeyDown="Jogging_KeyDown" PreviewKeyUp="Jogging_KeyUp" LostKeyboardFocus="Jogging_LostKeyboardFocus"/>
                            </Border>

                            <!-- VISUAL JOG PAD -->
                            <Grid Margin="0,15,0,0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row -->
                                <Button Content="↖" Grid.Column="0" Grid.Row="0" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="X-Y" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>
                                <Button Content="Y+" Grid.Column="1" Grid.Row="0" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="Y" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>
                                <Button Content="↗" Grid.Column="2" Grid.Row="0" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="XY" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>
                                <Button Content="Z+" Grid.Column="4" Grid.Row="0" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="Z" Style="{StaticResource styleButton}" Background="{DynamicResource LineStrongBrush}" Foreground="White" FontWeight="Bold"/>

                                <!-- Middle Row -->
                                <Button Content="X-" Grid.Column="0" Grid.Row="1" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="X-" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>
                                <Button Content="⏺" Grid.Column="1" Grid.Row="1" Margin="2" Click="ButtonJog_Click" Tag="STOP" Style="{StaticResource styleButton}" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" ToolTip="Stop Jogging / Cancel"/>
                                <Button Content="X+" Grid.Column="2" Grid.Row="1" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="X" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>

                                <!-- Bottom Row -->
                                <Button Content="↙" Grid.Column="0" Grid.Row="2" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="X-Y-" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>
                                <Button Content="Y-" Grid.Column="1" Grid.Row="2" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="Y-" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>
                                <Button Content="↘" Grid.Column="2" Grid.Row="2" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="XY-" Style="{StaticResource styleButton}" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White" FontWeight="Bold"/>
                                <Button Content="Z-" Grid.Column="4" Grid.Row="2" Margin="2" PreviewMouseLeftButtonDown="ButtonJog_MouseDown" PreviewMouseLeftButtonUp="ButtonJog_MouseUp" MouseLeave="ButtonJog_MouseUp" Tag="Z-" Style="{StaticResource styleButton}" Background="{DynamicResource LineStrongBrush}" Foreground="White" FontWeight="Bold"/>
                            </Grid>

                            <!-- PRESETS -->
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Step Size presets:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="5,0,0,2"/>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="0.1" Click="ButtonPresetStep_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                    <Button Content="1" Click="ButtonPresetStep_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                    <Button Content="10" Click="ButtonPresetStep_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                    <Button Content="100" Click="ButtonPresetStep_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                </WrapPanel>
                                <TextBlock Text="Feed Rate presets:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="5,10,0,2"/>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="100" Click="ButtonPresetFeed_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                    <Button Content="500" Click="ButtonPresetFeed_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                    <Button Content="1000" Click="ButtonPresetFeed_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                    <Button Content="2000" Click="ButtonPresetFeed_Click" Style="{StaticResource styleButton}" Margin="2" Width="45"/>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Margin="0,15,0,0" IsEnabled="{Binding ElementName=CheckBoxEnableJog, Path=IsChecked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Content="Feed:" Foreground="{DynamicResource TextMutedBrush}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox Name="TextBoxJogFeed" Text="{util:SettingBinding JogFeed}" Grid.Row="0" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>
                                <Label Content="Dist:" Foreground="{DynamicResource TextMutedBrush}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                                <TextBox Name="TextBoxJogDistance" Text="{util:SettingBinding JogDistance}" Grid.Row="0" Grid.Column="3" Margin="5" VerticalContentAlignment="Center"/>

                                <Label Content="Fine F:" Foreground="{DynamicResource TextMutedBrush}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox Name="TextBoxJogFeedFine" Text="{util:SettingBinding JogFeedCtrl}" Grid.Row="1" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>
                                <Label Content="Fine D:" Foreground="{DynamicResource TextMutedBrush}" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                                <TextBox Name="TextBoxJogDistanceFine" Text="{util:SettingBinding JogDistanceCtrl}" Grid.Row="1" Grid.Column="3" Margin="5" VerticalContentAlignment="Center"/>
                            </Grid>

                            <Separator Background="{DynamicResource SurfaceOverlayBrush}" Margin="0,15"/>
                            <TextBlock Text="MDI (Manual Data Input)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TextBoxManual" Height="30" PreviewKeyDown="TextBoxManual_PreviewKeyDown" TextChanged="TextBoxManual_TextChanged" Grid.Column="0" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                                <Button Name="ButtonManualSend" Click="ButtonManualSend_Click" Style="{StaticResource styleButton}" Content="Send" Grid.Column="1" Width="60" Background="{DynamicResource AccentBrush}" Foreground="White"/>
                            </Grid>
                            <TextBox Name="TextBoxPreview" IsReadOnly="True" Margin="0,5,0,5" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" Height="25" VerticalContentAlignment="Center"/>
                            <CheckBox Name="CheckBoxUseExpressions" Content="Use Expressions" IsChecked="{util:SettingBinding ManualUseExpressions}" Checked="CheckBoxUseExpressions_Changed" Unchecked="CheckBoxUseExpressions_Changed" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <WrapPanel HorizontalAlignment="Center">
                                <Button Name="ButtonManualSetG10Zero" Click="ButtonManualSetG10Zero_Click" Style="{StaticResource styleButton}" Content="Zero (G10)" Margin="2" Width="80"/>
                                <Button Name="ButtonManualSetG92Zero" Click="ButtonManualSetG92Zero_Click" Style="{StaticResource styleButton}" Content="Zero (G92)" Margin="2" Width="80"/>
                                <Button Name="ButtonManualResetG10" Click="ButtonManualResetG10_Click" Style="{StaticResource styleButton}" Content="Reset (G10)" Margin="2" Width="80"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- OVERRIDES -->
                    <GroupBox Header="Overrides" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <StackPanel Name="StackPanelOverrides" Margin="5">
                            
                            <!-- Feed -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Feed Override: " Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Name="RunFeedOvr" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                                <Button Name="ButtonFeedRateOvr" Content="100%" Click="ButtonFeedOverride_Click" Tag="100%" Style="{StaticResource styleButton}" Margin="10,0,0,0" Padding="5,0"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="ButtonFeedOverride_Click" Content="-10%" Style="{StaticResource styleButton}" Tag="-10%" Grid.Column="0" Margin="1"/>
                                <Button Click="ButtonFeedOverride_Click" Content="-1%" Style="{StaticResource styleButton}" Tag="-1%" Grid.Column="1" Margin="1"/>
                                <Button Click="ButtonFeedOverride_Click" Content="100%" Style="{StaticResource styleButton}" Tag="100%" Grid.Column="2" Margin="1" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White"/>
                                <Button Click="ButtonFeedOverride_Click" Content="+1%" Style="{StaticResource styleButton}" Tag="+1%" Grid.Column="3" Margin="1"/>
                                <Button Click="ButtonFeedOverride_Click" Content="+10%" Style="{StaticResource styleButton}" Tag="+10%" Grid.Column="4" Margin="1"/>
                            </Grid>

                            <!-- Spindle -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Spindle Override: " Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Name="RunSpindleOvr" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="ButtonSpindleOverride_Click" Content="-10%" Style="{StaticResource styleButton}" Tag="-10%" Grid.Column="0" Margin="1"/>
                                <Button Click="ButtonSpindleOverride_Click" Content="-1%" Style="{StaticResource styleButton}" Tag="-1%" Grid.Column="1" Margin="1"/>
                                <Button Click="ButtonSpindleOverride_Click" Content="100%" Style="{StaticResource styleButton}" Tag="100%" Grid.Column="2" Margin="1" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White"/>
                                <Button Click="ButtonSpindleOverride_Click" Content="+1%" Style="{StaticResource styleButton}" Tag="+1%" Grid.Column="3" Margin="1"/>
                                <Button Click="ButtonSpindleOverride_Click" Content="+10%" Style="{StaticResource styleButton}" Tag="+10%" Grid.Column="4" Margin="1"/>
                            </Grid>

                            <!-- Rapid -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Rapid Override: " Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Name="RunRapidOvr" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="ButtonRapidOverride_Click" Content="25%" Style="{StaticResource styleButton}" Tag="25" Grid.Column="0" Margin="1"/>
                                <Button Click="ButtonRapidOverride_Click" Content="50%" Style="{StaticResource styleButton}" Tag="50" Grid.Column="1" Margin="1"/>
                                <Button Click="ButtonRapidOverride_Click" Content="100%" Style="{StaticResource styleButton}" Tag="100" Grid.Column="2" Margin="1" Background="{DynamicResource SurfaceOverlayBrush}" Foreground="White"/>
                            </Grid>

                        </StackPanel>
                    </GroupBox>

                    <!-- HEIGHTMAP / PROBING -->
                    <GroupBox Header="HeightMap Probing" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Center">
                                <Button Name="ButtonHeightMapCreateNew" Click="ButtonHeightmapCreateNew_Click" Content="New" Style="{StaticResource styleButton}" Margin="2" Width="60"/>
                                <Button Name="ButtonHeightMapLoad" Click="ButtonHeightmapLoad_Click" Content="Load" Style="{StaticResource styleButton}" Margin="2" Width="60"/>
                                <Button Name="ButtonHeightMapSave" Click="ButtonHeightmapSave_Click" Content="Save" Style="{StaticResource styleButton}" Margin="2" Width="60"/>
                                <Button Name="ButtonHeightMapClear" Click="ButtonHeightmapClear_Click" Content="Clear" Style="{StaticResource styleButton}" Margin="2" Width="60"/>
                            </WrapPanel>

                            <Grid Name="GridProbingControls" Background="{DynamicResource SurfaceOverlayBrush}" Margin="0,0,0,10">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Points: " Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Label Name="LabelHeightMapProgress" Content="0/0" Foreground="White" FontWeight="Bold" Padding="0"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Name="ButtonHeightMapStart" Content="Run Probe" Click="ButtonHeightMapStart_Click" Style="{StaticResource styleButton}" Background="{DynamicResource SuccessBrush}" Foreground="White" Grid.Column="0" Margin="0,0,5,0"/>
                                        <Button Name="ButtonHeightMapPause" Content="Pause" Click="ButtonHeightMapPause_Click" Style="{StaticResource styleButton}" Background="{DynamicResource WarningBrush}" Foreground="White" Grid.Column="1" Margin="5,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="MinZ: " Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Label Name="LabelHeightMapMinZ" Content="0" Foreground="White" Margin="0,0,15,0" Padding="0"/>
                                        <TextBlock Text="MaxZ: " Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Label Name="LabelHeightMapMaxZ" Content="0" Foreground="White" Padding="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- MANUAL PROBING (TLO) -->
                    <GroupBox Name="groupBoxTLO" Header="Tool Length Offset (TLO)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15">
                        <StackPanel Margin="5">
                            <GroupBox Header="Last Probe Position" Foreground="{DynamicResource TextMutedBrush}">
                                <StackPanel Margin="5">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Machine: " Width="60" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastProbePosMachine.X, StringFormat=N3}" Width="50" Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Text="{Binding LastProbePosMachine.Y, StringFormat=N3}" Width="50" Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Text="{Binding LastProbePosMachine.Z, StringFormat=N3}" Width="50" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Work: " Width="60" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastProbePosWork.X, StringFormat=N3}" Width="50" Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Text="{Binding LastProbePosWork.Y, StringFormat=N3}" Width="50" Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Text="{Binding LastProbePosWork.Z, StringFormat=N3}" Width="50" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <CheckBox Content="Use Actual Pos vs Probe" IsChecked="{util:SettingBinding TLSUseActualPos}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,5"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Button Content="Save Pos" Style="{StaticResource styleButton}" Click="ButtonSaveTLOPos_Click" Width="80" Margin="0,0,10,0"/>
                                <TextBlock Text="@MZ: " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{util:SettingBinding ToolLengthSetterPos, StringFormat=N3}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Apply TLO" Style="{StaticResource styleButton}" Click="ButtonApplyTLO_Click" Grid.Column="0" Margin="0,0,2,0"/>
                                <Button Content="Clear TLO" Style="{StaticResource styleButton}" Click="ButtonClearTLO_Click" Grid.Column="1" Margin="2,0,2,0"/>
                                <TextBox Name="TextBoxCurrentTLO" Text="0.000" IsReadOnly="True" Grid.Column="2" Margin="2,0,0,0" VerticalContentAlignment="Center" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="White" BorderThickness="0"/>
                            </Grid>

                            <GroupBox Header="Probe Offset" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="X: " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Width="50" Text="{util:SettingBinding ProbeOffsetX}" Margin="0,0,15,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Y: " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Width="50" Text="{util:SettingBinding ProbeOffsetY}" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <Button Name="ButtonSyncBuffer" Click="ButtonSyncBuffer_Click" Height="40" Margin="0,0,0,20">
                        <Grid>
                            <ProgressBar Name="ProgressBarBufferCapacity" Maximum="{util:SettingBinding ControllerBufferSize}" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="{DynamicResource AccentTextBrush}" Opacity="0.3"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Buffer: " Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Label Name="LabelBufferState" Content="0" Foreground="White" FontWeight="Bold" Padding="0" VerticalAlignment="Center"/>
                                <TextBlock Text=" / " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{util:SettingBinding ControllerBufferSize}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- CENTER 3D VIEWPORT -->
        <Grid Background="{DynamicResource SurfaceRaisedBrush}">
            <StackPanel Panel.ZIndex="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,20">
                <Label Name="LabelStateProbe" Content="Probe" FontWeight="ExtraBold" FontSize="40" Foreground="Red" Visibility="Collapsed"/>
                <Label Name="LabelStateLimitX" Content="LimitX" FontWeight="ExtraBold" FontSize="40" Foreground="Red" Visibility="Collapsed"/>
                <Label Name="LabelStateLimitY" Content="LimitY" FontWeight="ExtraBold" FontSize="40" Foreground="Red" Visibility="Collapsed"/>
                <Label Name="LabelStateLimitZ" Content="LimitZ" FontWeight="ExtraBold" FontSize="40" Foreground="Red" Visibility="Collapsed"/>
            </StackPanel>

            <h:HelixViewport3D Name="viewport" ShowViewCube="False" Panel.ZIndex="0" PreviewKeyDown="viewport_PreviewKeyDown" ZoomAroundMouseDownPoint="true">
                <h:HelixViewport3D.Camera>
                    <PerspectiveCamera
						Position="50, -150, 250"
						LookDirection="-50, 150,-250"
						UpDirection="0,0,1"/>
                </h:HelixViewport3D.Camera>

                <h:DefaultLights/>
                <h:CoordinateSystemVisual3D ArrowLengths="5"/>
                <h:LinesVisual3D Thickness="0.5" Color="Gray" x:Name="ModelRapid"/>
                <h:LinesVisual3D Thickness="1" Color="Black" x:Name="ModelLine"/>
                <h:LinesVisual3D Thickness="1" Color="Blue" x:Name="ModelArc"/>
                <h:ArrowVisual3D x:Name="ModelTool" Direction="0,0,-10"/>
                <h:GridLinesVisual3D
					x:Name="ModelGrid"
					Width="500" Length="500" 
					Thickness="{util:SettingBinding GridThickness}"/>
                <h:MeshGeometryVisual3D
					x:Name="ModelHeightMap">
                    <!--
                        The material is built in code from Colormap so that the surface and
                        the legend beside it can never drift apart. The rainbow ramp that
                        used to be here was not perceptually uniform: it invented a bright
                        band at yellow, so a gentle bow read as a sharp ridge.
                    -->
                </h:MeshGeometryVisual3D>
                <h:LinesVisual3D x:Name="ModelHeightMapBoundary" Thickness="2" Color="Lime"/>
                <h:PointsVisual3D x:Name="ModelHeightMapPoints" Color="Red" Size="4"/>
                <h:LinesVisual3D x:Name="ModelFileBoundary" Color="GreenYellow" Thickness="2.5"/>
                <h:PointsVisual3D x:Name="ModelFileBoundaryPoints" Color="Green" Size="8"/>
                <h:TextVisual3D x:Name="ModelTextMinPoint" UpDirection="0,1,0" Height="7" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <h:TextVisual3D x:Name="ModelTextMaxPoint" UpDirection="0,1,0" Height="7" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                <h:QuadVisual3D Point1="-1000,-1000,0" Point2="1000,-1000,0" Point3="1000,1000,0"  Point4="-1000,1000,0">
                    <h:QuadVisual3D.Material>
                        <DiffuseMaterial Brush="Transparent"/>
                    </h:QuadVisual3D.Material>
                    <h:QuadVisual3D.BackMaterial>
                        <DiffuseMaterial Brush="Transparent"/>
                    </h:QuadVisual3D.BackMaterial>
                </h:QuadVisual3D>
            </h:HelixViewport3D>

            <!-- Console Overlay on the bottom left of viewport -->
            <ListBox Name="ListBoxHistory" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Foreground="{DynamicResource TextMutedBrush}" FontSize="14">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
